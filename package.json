{
  "name": "opentos-generative-design",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build:web",
    "dev:web": "npm --workspace @opentos/web run dev",
    "dev:api": "cd apps/api && .venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "build:web": "npm --workspace @opentos/web run build",
    "test:web": "npm --workspace @opentos/web run test",
    "test:api": "cd apps/api && .venv/bin/python -m pytest",
    "test": "npm run test:web && npm run test:api",
    "deploy:cf": "npx wrangler deploy",
    "sample:generate": "python3 scripts/generate_sample_part.py"
  }
}
