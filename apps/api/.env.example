# Copy values into your deployment secret manager or export them in the shell.
OPENTOS_DATA_DIR=../../data
DATABASE_URL=sqlite:///../../data/opentos.db
OPENTOS_MAX_WORKERS=2
OPENTOS_MAX_UPLOAD_BYTES=104857600
OPENTOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_PROVIDER=openai
AI_MODEL=gpt-5.6-sol
AI_REASONING_EFFORT=xhigh
AI_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
